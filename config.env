# Fleetmate agenda export - configuratie
# Dit bestand bevat je API-key: niet delen, niet in git zetten (chmod 600).

FLEETMATE_BASE_URL=https://srv5.fleetmate.online/api/v2/
FLEETMATE_API_KEY=8aec4306-e21b-40be-aa97-90745299b1a

# Lijst-endpoint van de agenda (relatief t.o.v. de base URL), bv. appointments
# Onbekend? Draai: .venv/bin/python fleetmate_export.py --discover
AGENDA_ENDPOINT=agendas
VEHICLES_ENDPOINT=vehicles
ONLY_FUTURE=true
EXCLUDE_HISTORY=true
EXCEL_EXCLUDE_ITEM_TYPES=0,6
PAGINATE=false

# Optioneel OData-filter (wordt automatisch URL-encoded), bv: startDate gt '2026-01-01'
AGENDA_WHERE=

# Alleen events uit dit jaar in Excel zetten (leeg = alles). Ruwe CSV bevat altijd alles uit de API.
YEAR=2026
EXCEL_UNTIL=2027-01

# Excel-bestand (relatief t.o.v. deze map, of absoluut pad)
XLSX_PATH=werkplaats_agenda_2026.xlsx

PAGE_SIZE=500

# Veldnamen in de API-response. Leeg = automatisch herkennen.
# Draai --probe <endpoint> om te zien welke velden er zijn. Geneste velden met punt: vehicle.license
FIELD_DATE=
FIELD_LICENSE=
FIELD_TRUCK=
FIELD_DESCRIPTION=
# Leeg = Type afleiden uit omschrijving (CFK, APK, Koeler, Oplegger, Onderhoud, FRC, Tachograaf, Alarm)
FIELD_TYPE=
